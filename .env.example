# APP_ENV is explicit; NODE_ENV never selects financial mode.
APP_ENV=local
PUBLIC_APP_URL=http://localhost:3000
STAGING_PROVIDER_DAILY_CAP_USD=2.00
PROVIDER_EXECUTION_PAUSED=false
RATE_LIMIT_NAMESPACE=industry-local
CAPTURE_STORAGE_BUCKET=browser-captures
ICON_STORAGE_BUCKET=agent-icons
# Copy to .env. Never commit real credentials. Mainnet stays disabled.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# demo: labelled seed history/test credits. live: unseeded managed Postgres + live model required.
APP_MODE=demo
# Supabase Postgres connection (TLS required outside local mode). Empty uses .data/postgres.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Production: random 32+ byte secrets; local startup generates private values in .data.
SESSION_SECRET=
INTERNAL_API_SECRET=
# Required separately in live mode; shared only with the worker and database service.
WORKER_API_SECRET=
WALLET_ENCRYPTION_KEY=
# Optional comma-separated authenticated administrator public wallet addresses.
ADMIN_WALLETS=
SOLANA_NETWORK=devnet
# Public devnet endpoint works without credentials; use a dedicated provider for staging.
SOLANA_RPC_URL=https://api.devnet.solana.com
HELIUS_API_KEY=
AGENTS_ENABLED=true
TOKEN_LAUNCH_ENABLED=true
ENABLE_DEVNET_TOKEN_LAUNCH=true
AUTONOMOUS_PAYMENTS_ENABLED=true
# Verified public V2 devnet facilitator; no credential needed for this test service.
X402_FACILITATOR_URL=https://x402.org/facilitator
# Optional bearer token for a private compatible facilitator. Never exposed to clients.
X402_FACILITATOR_TOKEN=
# Server-only key. Never use NEXT_PUBLIC_ or paste into browser/client code.
# Only enabled models from the canonical approved registry are available.
OPENROUTER_API_KEY=
# Optional OPENROUTER_ALLOWED_MODELS below can narrow, never expand, the registry.
# Model pricing ceilings in USD per million tokens; required for live model.
MODEL_INPUT_PRICE_PER_MILLION=100
MODEL_OUTPUT_PRICE_PER_MILLION=500
# OpenRouter web plugin uses the same private key; Brave is an optional explicit alternative.
SEARCH_PROVIDER=openrouter
SEARCH_PROVIDER_API_KEY=
# fetch (default) or local. Browserbase is selected when its API key is present.
BROWSER_PROVIDER=fetch
# Optional absolute Chromium/Edge executable for the local bounded browser tool.
BROWSER_EXECUTABLE_PATH=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
MAINNET_ENABLED=false
ENABLE_MAINNET=false
ENABLE_MAINNET_TOKEN_LAUNCH=false
ENABLE_AUTONOMOUS_MAINNET_SPEND=false
# Isolated, inactive production token adapter only. Requires a separate custody
# implementation and reviewed composition change; never set during V1/devnet work.
MAINNET_RPC_URL=
MAINNET_LAUNCH_APPROVAL_REFERENCE=
EMERGENCY_PAUSE=false
# Internal loopback services, never expose the database RPC publicly.
DB_PORT=4318
DB_HOST=127.0.0.1
# Empty uses loopback. Containers use a private service URL; use TLS across hosts.
INTERNAL_API_URL=
# Leave empty unless a trusted ingress strips and overwrites the named IP header.
TRUST_PROXY_IP_HEADER=
PORT=3000
# Operational: NODE_ENV=production, NEXT_TELEMETRY_DISABLED=1 on deployment.
# PLAYWRIGHT_BROWSERS_PATH may locate installed test-browser binaries.

# Current structured-output support and prices are verified before launch/execution.
OPENROUTER_ALLOWED_MODELS=

# Internal USDC-credit settlement stays disabled outside demo until an operator
# has reconciled/funded the pooled ledger. No autonomous chain withdrawal path.
INTERNAL_LEDGER_ENABLED=false
# Public pooled treasury address only. Pump independently proves its locked
# 100% creator-fee share before activation; an address alone proves nothing.
INDUSTRY_FEE_TREASURY=
# Fee phase percentages and thresholds are configured via authenticated admin
# API /api/admin/fee-policy overrides packages/core/fee-policy.ts approved V1 defaults.

# Pump SDK 2.0.0. Disabled by default; no public/mainnet launch during development.
PUMP_NETWORK=devnet
PUMP_RPC_URL=
PUMP_METADATA_BASE_URL=
PUMP_LOOKUP_TABLES=
PUMP_LAUNCH_ENABLED=false
PUMP_MAINNET_LAUNCH_ENABLED=false
PUMP_MAINNET_COLLECTION_ENABLED=false
PUMP_MAINNET_APPROVAL_REFERENCE=
# Explicit public rollout; false retains the wallet allowlist.
PUMP_PUBLIC_LAUNCH_ENABLED=false
PUMP_LAUNCH_ALLOWLIST=
PUMP_RECONCILIATION_ENABLED=false
PUMP_FEE_COLLECTION_ENABLED=false
# Separate small operational gas wallet. NEVER the pooled treasury private key.
INDUSTRY_FEE_COLLECTOR=
PUMP_COLLECTOR_KEYPAIR_FILE=
PUMP_COLLECTOR_API_SECRET=
# Conservative development limits; operators must review before real use.
PUMP_FEE_COLLECTION_INTERVAL=300
PUMP_MIN_COLLECTION_AMOUNT=0.01
PUMP_MAX_TX_COST_RATIO=0.05
PUMP_COLLECTION_BATCH_SIZE=3
PUMP_COLLECTOR_MAX_BALANCE_LAMPORTS=100000000
PUMP_MAX_TX_FEE_LAMPORTS=100000
PUMP_MAX_DAILY_TX_FEE_LAMPORTS=1000000
# Read-only USD accounting valuation. No SOL->USDC swap is constructed.
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=

SEARCH_PROVIDER=openrouter


# OpenRouter is the sole inference gateway. Optional allowlist narrows approved models only.
# Model price ceilings do not raise Coin run limits or the platform daily cap.
