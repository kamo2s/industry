# Local defaults work with `pnpm dev`. Never commit .env or real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_MODE=demo
# Supabase Postgres connection (TLS required outside local mode). Empty uses .data/postgres.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Production: random 32+ byte secrets; local startup generates private values in .data.
SESSION_SECRET=
INTERNAL_API_SECRET=
WALLET_ENCRYPTION_KEY=
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=
HELIUS_API_KEY=
# Enable only after funding the generated dedicated devnet wallet with test SOL.
ENABLE_DEVNET_TOKEN_LAUNCH=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Model pricing ceilings in USD per million tokens; required for live model.
MODEL_INPUT_PRICE_PER_MILLION=
MODEL_OUTPUT_PRICE_PER_MILLION=
SEARCH_PROVIDER_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
ENABLE_MAINNET=false
ENABLE_MAINNET_TOKEN_LAUNCH=false
ENABLE_AUTONOMOUS_MAINNET_SPEND=false
EMERGENCY_PAUSE=false
# Internal loopback services, never expose the database RPC publicly.
DB_PORT=4318
PORT=3000
